{
  "name": "sumi-kami",
  "description": "Sumikami is a form builder SaaS with a Next.js dashboard, an Express/tRPC API, and a versioned PostgreSQL data model.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "db:generate": "dotenv -- turbo run db:generate",
    "db:migrate": "dotenv -- turbo run db:migrate",
    "db:seed": "dotenv -- turbo run db:seed",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate:prod": "pnpm --filter @repo/database db:migrate:prod",
    "auth:import:clerk:dev": "dotenv -e apps/api/.env.local --no-expand -o -- pnpm --filter @repo/services auth:import:clerk",
    "dev:auth": "turbo run dev --filter=web --filter=@repo/api"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,json,jsonc,md,yaml,yml,css,scss,html}": "prettier --check"
  },
  "devDependencies": {
    "husky": "9",
    "lint-staged": "15",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
