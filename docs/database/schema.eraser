// Current core schema through migration 0010, plus external Clerk identity.
// clerk_identity is external; its link is not a PostgreSQL foreign key.
// users/sessions are public tables; other local entities are in builder.
// sessions/password_hash are legacy, not current authentication.
// Relationships below show individual FK paths for readability.
// Implementation uses composite workspace/version/submission FKs.
// Nullable columns, composite uniqueness, checks, RLS, and triggers
// are specified in docs/database/architecture.md.

clerk_identity [color: gray] {
  id text pk
  external_id text optional_imported_local_uuid
}

users {
  id uuid pk
  clerk_user_id text unique nullable external_reference
  full_name varchar
  email varchar unique
  email_verified boolean
  profile_image_url text nullable
  password_hash text nullable legacy
  role user_role
  last_login_at timestamp nullable legacy
  deleted_at timestamptz nullable
  created_at timestamp nullable
  updated_at timestamp nullable
}

// Retained for compatibility; Clerk sessions are not stored in this table.
sessions [color: gray] {
  id uuid pk
  user_id uuid fk
  token_hash text unique
  ip inet nullable
  user_agent text nullable
  created_at timestamp
  expires_at timestamp
  revoked_at timestamp nullable
}

workspaces {
  id uuid pk
  owner_user_id uuid fk
  name varchar
  slug varchar unique
  retention_days integer
  deleted_at timestamptz
}

workspace_memberships {
  id uuid pk
  workspace_id uuid fk
  user_id uuid fk
  role text
}

forms {
  id uuid pk
  workspace_id uuid fk
  creator_user_id uuid fk
  slug varchar unique
  published_version_id uuid fk
  archived_at timestamptz
  deleted_at timestamptz
}

form_versions {
  id uuid pk
  workspace_id uuid fk
  form_id uuid fk
  version_number integer
  status text
  title varchar
  description text
  settings jsonb
  revision integer
  published_at timestamptz
}

form_steps {
  id uuid pk
  workspace_id uuid fk
  version_id uuid fk
  key varchar
  title varchar
  position integer
}

field_types {
  code text pk
  storage_kind text
}

form_fields {
  id uuid pk
  workspace_id uuid fk
  version_id uuid fk
  step_id uuid fk
  key varchar
  type_code text fk
  label text
  required boolean
  position integer
  configuration jsonb
  validation jsonb
}

field_options {
  id uuid pk
  workspace_id uuid fk
  version_id uuid fk
  field_id uuid fk
  key varchar
  label text
  position integer
}

form_logic_rules {
  id uuid pk
  workspace_id uuid fk
  version_id uuid fk
  source_field_id uuid fk
  priority integer
  condition jsonb
  action_kind text
  target_step_id uuid fk
  target_field_id uuid fk
}

form_submissions {
  id uuid pk
  workspace_id uuid fk
  form_id uuid fk
  version_id uuid fk
  respondent_user_id uuid fk
  status text
  idempotency_key text
  metadata jsonb
  started_at timestamptz
  completed_at timestamptz
  expires_at timestamptz
  deleted_at timestamptz
}

submission_answers {
  id uuid pk
  workspace_id uuid fk
  version_id uuid fk
  submission_id uuid fk
  field_id uuid fk
  storage_kind text
  value_text text
  value_number numeric
  value_boolean boolean
  value_date date
  value_datetime timestamptz
  value_json jsonb
}

answer_selections {
  workspace_id uuid fk
  version_id uuid fk
  answer_id uuid fk
  field_id uuid fk
  option_id uuid fk
}

submission_files {
  id uuid pk
  workspace_id uuid fk
  version_id uuid fk
  submission_id uuid fk
  object_key text
  original_filename text
  media_type text
  byte_count bigint
  checksum text
  upload_state text
}

answer_files {
  workspace_id uuid fk
  version_id uuid fk
  submission_id uuid fk
  answer_id uuid fk
  file_id uuid fk
}

workspace_audit_events {
  id uuid pk
  workspace_id uuid fk
  actor_user_id uuid fk
  action text
  entity_type text
  entity_id uuid
  metadata jsonb
  created_at timestamptz
}

// Optional application mapping, not a cross-service SQL foreign key.
users.clerk_user_id - clerk_identity.id
sessions.user_id > users.id
workspaces.owner_user_id > users.id
workspace_memberships.workspace_id > workspaces.id
workspace_memberships.user_id > users.id
forms.workspace_id > workspaces.id
forms.creator_user_id > users.id
forms.published_version_id - form_versions.id
form_versions.workspace_id > workspaces.id
form_versions.form_id > forms.id
form_steps.version_id > form_versions.id
form_fields.version_id > form_versions.id
form_fields.step_id > form_steps.id
form_fields.type_code > field_types.code
field_options.field_id > form_fields.id
form_logic_rules.version_id > form_versions.id
form_logic_rules.source_field_id > form_fields.id
form_logic_rules.target_step_id > form_steps.id
form_logic_rules.target_field_id > form_fields.id
form_submissions.workspace_id > workspaces.id
form_submissions.form_id > forms.id
form_submissions.version_id > form_versions.id
form_submissions.respondent_user_id > users.id
submission_answers.submission_id > form_submissions.id
submission_answers.field_id > form_fields.id
answer_selections.answer_id > submission_answers.id
answer_selections.field_id > form_fields.id
answer_selections.option_id > field_options.id
submission_files.submission_id > form_submissions.id
answer_files.submission_id > form_submissions.id
answer_files.answer_id > submission_answers.id
answer_files.file_id > submission_files.id
workspace_audit_events.workspace_id > workspaces.id
workspace_audit_events.actor_user_id > users.id
